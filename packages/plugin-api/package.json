{
  "name": "@agent-proxy/plugin-api",
  "version": "0.11.0",
  "description": "Agent Proxy 插件与主机公共契约。",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    },
    "./*.json": "./dist/*.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun ../../scripts/build-library.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "bun ../../scripts/verify-package.ts ."
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aceHubert/codex-cliproxy-gateway.git"
  }
}
