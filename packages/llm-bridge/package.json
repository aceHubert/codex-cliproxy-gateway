{
  "name": "@agent-proxy/llm-bridge",
  "version": "0.11.1",
  "description": "Agent Proxy 的 llm-bridge 协议转换与流式处理接口。",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    },
    "./*.json": "./dist/*.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun ../../scripts/build-library.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "bun ../../scripts/verify-package.ts ."
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aceHubert/codex-cliproxy-gateway.git"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.56.0",
    "@google/generative-ai": "0.24.1",
    "llm-bridge": "2.0.1",
    "openai": "5.8.2"
  }
}
