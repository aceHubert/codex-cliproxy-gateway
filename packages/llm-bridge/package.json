{
  "name": "@agent-proxy/llm-bridge",
  "version": "0.14.0",
  "description": "Agent Proxy 的 llm-bridge 协议转换与流式处理接口。",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    },
    "./*.json": "./dist/*.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun ../../scripts/build-library.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "bun ../../scripts/verify-package.ts ."
  },
  "publishConfig": {
    "access": "public",
    "timeout": 30000
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aceHubert/codex-cliproxy-gateway.git"
  },
  "dependencies": {
    "@agent-proxy/plugin-api": "workspace:*",
    "@ai-sdk/anthropic": "~4.0.79",
    "@ai-sdk/google": "~4.0.95",
    "@ai-sdk/openai": "~4.0.93",
    "@ai-sdk/provider": "~4.0.27",
    "ai": "~7.0.140"
  },
  "devDependencies": {
    "@types/json-schema": "7.0.15"
  }
}
