{
  "name": "agent-proxy-monorepo",
  "version": "0.10.0",
  "description": "A cross-platform Bun-powered local gateway that keeps Codex ChatGPT OAuth for native models and routes cliproxy/* models to CLIProxyAPI.",
  "type": "module",
  "scripts": {
    "dev": "bun run build:packages && bun apps/gateway/src/index.ts",
    "dev:ui": "CODEX_CLIPROXY_UI_DEV=1 bun run dev web && vite --config vite.config.ts",
    "build:ui": "bun scripts/build-ui.ts",
    "build": "lerna run build",
    "build:packages": "lerna run build --ignore @agent-proxy/gateway",
    "changelog": "bun scripts/changelog.ts",
    "test": "bun run build:packages && bun scripts/run-tests.ts",
    "typecheck": "bun run build:packages && tsc --noEmit && lerna run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check:boundaries": "bun scripts/check-boundaries.ts",
    "check": "bun run lint && bun run check:boundaries && bun run build && bun run typecheck && bun run test",
    "commit": "git-cz",
    "commitlint": "commitlint --edit",
    "preversion": "bun run release:check",
    "version": "bun run changelog",
    "release:check": "if [ \"$CODEX_CLIPROXY_SKIP_TESTS\" = \"1\" ]; then bun run check:boundaries && bun run typecheck && bun run build; else bun run check; fi && bun scripts/pack-check.ts",
    "release:version": "bun scripts/release-version.ts",
    "release": "lerna publish from-git",
    "pack:check": "bun run build && bun scripts/pack-check.ts"
  },
  "keywords": [
    "codex",
    "cliproxy",
    "bun",
    "gateway",
    "openai",
    "claude",
    "gemini"
  ],
  "devDependencies": {
    "@agent-proxy/agy": "workspace:*",
    "@agent-proxy/codebuddy": "workspace:*",
    "@agent-proxy/llm-bridge": "workspace:*",
    "@agent-proxy/models": "workspace:*",
    "@agent-proxy/opencode-zen": "workspace:*",
    "@agent-proxy/plugin-api": "workspace:*",
    "@agent-proxy/qoder": "workspace:*",
    "@agent-proxy/zcode": "workspace:*",
    "@anthropic-ai/sdk": "0.56.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@google/generative-ai": "0.24.1",
    "@types/bun": "^1.3.5",
    "@types/bytes": "^3.1.6",
    "@types/node": "26.4.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog-zh": "^0.0.2",
    "eslint": "^10.14.0",
    "eslint-plugin-import-x": "^4.18.0",
    "eslint-plugin-perfectionist": "^5.13.0",
    "i18next": "^26.4.2",
    "lerna": "^10.0.1",
    "lerna-changelog": "^2.2.0",
    "lint-staged": "^16.2.7",
    "openai": "5.8.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "yaml": "^2.9.0",
    "yorkie": "^2.0.0"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aceHubert/codex-cliproxy-gateway.git"
  },
  "homepage": "https://github.com/aceHubert/codex-cliproxy-gateway#readme",
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog-zh"
    }
  },
  "gitHooks": {
    "pre-commit": "lint-staged",
    "commit-msg": "commitlint --env GIT_PARAMS"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": "eslint --fix --no-warn-ignored"
  },
  "trustedDependencies": [
    "yorkie"
  ],
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
