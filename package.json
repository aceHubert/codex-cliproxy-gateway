{
  "name": "codex-cliproxy-gateway",
  "version": "0.4.0",
  "description": "A cross-platform Bun-powered local gateway that keeps Codex ChatGPT OAuth for native models and routes cliproxy/* models to CLIProxyAPI.",
  "type": "module",
  "bin": {
    "codex-cliproxy": "./dist/index.js"
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "models.json",
    "schemas/gateway-config.schema.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "bun src/index.ts",
    "dev:ui": "CODEX_CLIPROXY_UI_DEV=1 bun run dev web && vite --config vite.config.ts",
    "build:ui": "bun scripts/build-ui.ts",
    "build": "bun run build:ui && bun build src/index.ts --target=bun --format=esm --outfile=dist/index.js",
    "changelog": "bun scripts/changelog.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun test && bun run build",
    "commit": "git-cz",
    "commitlint": "commitlint --edit",
    "prepack": "bun run release:check",
    "preversion": "bun run release:check",
    "version": "bun run changelog",
    "release:check": "if [ \"$CODEX_CLIPROXY_SKIP_TESTS\" = \"1\" ]; then bun run typecheck && bun run build; else bun run check; fi",
    "release:version": "lerna version",
    "release": "lerna publish from-git"
  },
  "keywords": [
    "codex",
    "cliproxy",
    "bun",
    "gateway",
    "openai",
    "claude",
    "gemini"
  ],
  "dependencies": {
    "bytes": "^3.1.2",
    "llm-bridge": "2.0.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "0.56.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@google/generative-ai": "0.24.1",
    "@types/bun": "^1.3.5",
    "@types/bytes": "^3.1.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog-zh": "^0.0.2",
    "lerna": "^10.0.1",
    "lerna-changelog": "^2.2.0",
    "openai": "5.8.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3",
    "yorkie": "^2.0.0"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aceHubert/codex-cliproxy-gateway.git"
  },
  "homepage": "https://github.com/aceHubert/codex-cliproxy-gateway#readme",
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog-zh"
    }
  },
  "gitHooks": {
    "commit-msg": "commitlint --env GIT_PARAMS"
  },
  "trustedDependencies": [
    "yorkie"
  ],
  "publishConfig": {
    "access": "public"
  }
}
