{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/aceHubert/codex-cliproxy/main/schemas/gateway-config.schema.json",
  "title": "codex-cliproxy gateway config",
  "type": "object",
  "required": [
    "host",
    "port",
    "mountPath",
    "prefix",
    "officialBaseUrl",
    "upstreamBaseUrl",
    "catalogPath",
    "configVersion"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri"
    },
    "configVersion": {
      "type": "string",
      "minLength": 1
    },
    "host": {
      "type": "string",
      "minLength": 1
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "mountPath": {
      "type": "string",
      "pattern": "^/"
    },
    "prefix": {
      "type": "string"
    },
    "officialBaseUrl": {
      "type": "string",
      "format": "uri"
    },
    "upstreamBaseUrl": {
      "description": "第三方上游 URL（CLIProxyAPI 或 OpenAI 兼容的 new-api）。",
      "type": "string",
      "format": "uri"
    },
    "cliproxyBaseUrl": {
      "description": "已过时，由 upstreamBaseUrl 取代；命令前置同步会自动把旧值迁移为 upstreamBaseUrl 并移除该键。",
      "type": "string",
      "format": "uri",
      "deprecated": true
    },
    "upstreamType": {
      "description": "第三方上游类型：cliproxy 直接消费其 Codex 目录；newapi 从 OpenAI /models 列表本地合成目录。缺省视为 cliproxy。",
      "type": "string",
      "enum": ["cliproxy", "newapi"]
    },
    "upstream_type": {
      "description": "已过时，由 upstreamType 取代；命令前置同步会自动迁移并移除该键。",
      "type": "string",
      "deprecated": true
    },
    "catalogPath": {
      "type": "string",
      "minLength": 1
    },
    "model_merge_json": {
      "type": "string",
      "format": "uri"
    },
    "selectedModels": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "requestLogging": {
      "type": "boolean"
    },
    "logDir": {
      "type": "string",
      "minLength": 1
    },
    "maxRequestLogs": {
      "description": "整个请求日志目录按修改时间保留的最新文件数，不按路由分组；正在写入的日志（如未结束的 WebSocket 会话文件）不参与裁剪；0 表示不限制。",
      "type": "integer",
      "minimum": 0
    },
    "maxGatewayLogBytes": {
      "description": "网关进程日志 gateway.log 与 gateway.error.log 的最大字节数；超限时当前内容复制为时间戳备份（每个文件保留最新 5 个）并原地清空活跃文件，进程持有的句柄继续有效；设置上限同时约束 gateway.log 中配置审计的可追溯深度；0 表示不限制。",
      "type": "integer",
      "minimum": 0
    },
    "upstreamOnly": {
      "description": "是否只使用第三方上游并纯转发模型名，不添加 cliproxy/ 前缀。",
      "type": "boolean"
    },
    "zcode": {
      "description": "是否启用 ZCode Responses 入口；默认关闭。upstreamOnly 为 true 时该入口按禁用处理（开关保留但不生效）。",
      "type": "boolean",
      "default": false
    },
    "cpaOnly": {
      "description": "已过时，由 upstreamOnly 取代；命令前置同步会自动迁移并移除该键。",
      "type": "boolean",
      "deprecated": true
    }
  },
  "additionalProperties": true
}
