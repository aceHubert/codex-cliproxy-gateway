{
  "name": "@agent-proxy/gateway",
  "version": "0.14.1",
  "description": "Agent Proxy 的 Bun 网关与 CLI 业务应用。",
  "type": "module",
  "bin": {
    "agent-proxy": "./dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "config.schema.json",
    "README.md"
  ],
  "scripts": {
    "dev": "bun src/index.ts",
    "build": "bun ../../scripts/build-gateway.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "bun ../../scripts/verify-package.ts ."
  },
  "dependencies": {
    "@agent-proxy/agy": "workspace:*",
    "@agent-proxy/codebuddy": "workspace:*",
    "@agent-proxy/opencode-zen": "workspace:*",
    "@agent-proxy/plugin-api": "workspace:*",
    "@agent-proxy/qoder": "workspace:*",
    "@agent-proxy/zcode": "workspace:*",
    "bytes": "^3.1.2",
    "i18next": "^26.4.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^17.0.16",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@agent-proxy/models": "workspace:*"
  },
  "engines": {
    "bun": ">=1.2.0"
  },
  "publishConfig": {
    "access": "public",
    "timeout": 30000
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aceHubert/codex-cliproxy-gateway.git"
  }
}
